# ==============================================================================
# DevDoc Copilot — Environment Configuration
# ==============================================================================
# Choose ONE of the LLM provider configurations below by uncommenting its block.
# All providers use the universal OpenAI-compatible chat completions interface.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Groq (Recommended Free Cloud Tier — Fast & No Credit Card Needed)
# Get your free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_ENDPOINT=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# OPTION 2: Local Ollama (Recommended 100% Free & Offline — Code Privacy)
# Run locally: `ollama run qwen2.5-coder:7b`
# ------------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:7b
# LLM_ENDPOINT=http://localhost:11434/v1
# LLM_API_KEY=""

# ------------------------------------------------------------------------------
# OPTION 3: OpenAI (Commercial Standard)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-your_openai_api_key_here

# ------------------------------------------------------------------------------
# OPTION 4: Google Gemini (AI Studio or Vertex AI)
# For AI Studio: Get key from https://aistudio.google.com/
# ------------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=AIzaSy_your_gemini_api_key_here
# # If using Google Cloud Vertex AI instead of AI Studio:
# # GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# # GCP_LOCATION=us-central1

# ------------------------------------------------------------------------------
# OPTION 5: Custom OpenAI-Compatible Proxy (OpenRouter, DeepSeek, Together, vLLM)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek/deepseek-chat
# LLM_ENDPOINT=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your_key_here

# ==============================================================================
# Embeddings Configuration (Default: Local, Offline & Free)
# ==============================================================================
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==============================================================================
# Storage & Paths
# ==============================================================================
DATA_ROOT_DIRECTORY=./.data_storage
UPLOAD_DIR=./uploads

# ==============================================================================
# Server & Network Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# Codebase Ingestion Constraints
# ==============================================================================
CODE_EXTENSIONS=.py,.js,.ts,.jsx,.tsx,.java,.go,.rs,.rb,.php,.c,.cpp,.h,.hpp,.cs,.swift,.kt,.scala,.json,.md,.sh,.yaml,.yml,.toml
CODE_INGEST_BATCH_SIZE=100
MAX_CODE_FILES=600
MAX_CODE_FILE_BYTES=1048576
